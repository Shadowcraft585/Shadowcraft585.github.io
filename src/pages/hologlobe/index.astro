---
import Project from '../../layouts/Project.astro';
import { Image } from 'astro:assets';
import HoloGlobe from '../../assets/hologlobe.jpg';
---

<style>
  .holo-grid {
    background-image:
      linear-gradient(rgba(59, 130, 246, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(59, 130, 246, 0.06) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .glow {
    box-shadow:
      0 0 20px rgba(59, 130, 246, 0.15),
      0 0 60px rgba(37, 99, 235, 0.08);
  }

  .glow-blue {
    text-shadow: 0 0 15px rgba(59, 130, 246, 0.7);
  }

  .tech-line {
    position: relative;
  }

  .tech-line::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(
      to bottom,
      rgb(59, 130, 246),
      rgb(6, 182, 212)
    );
    border-radius: 999px;
  }

  .architecture-arrow {
    color: rgb(96, 165, 250);
    font-size: 1.5rem;
  }
</style>

<Project
  title="Kevin Ganske"
  description="Kevin Ganskes Website"
>

  <!-- HEADER -->

<section class="mb-10">

  <!-- Text -->
  <div>
    <p class="text-blue-400 font-mono text-sm mb-2">
      EMBEDDED SYSTEMS · SOMMERSEMESTER 2026
    </p>

    <h1 class="text-blue-400 text-4xl md:text-5xl font-bold mb-4 glow-blue">
      HoloGlobe
    </h1>

    <p class="text-xl text-gray-300 leading-relaxed max-w-3xl mx-auto text-center">
      Eine rotierende LED-Kugel, die Flugzeuge in Echtzeit auf einer
      dreidimensionalen Weltkarte visualisiert.
    </p>

    <p class="text-gray-400 mt-4 max-w-3xl leading-relaxed mx-auto text-center">
      Im Team wurde ein bestehender LED-Globus zu einem interaktiven
      ADS-B-Visualisierungssystem erweitert. Flugzeugdaten werden über
      1090 MHz empfangen, verarbeitet und anschließend drahtlos an die
      rotierende LED-Kugel übertragen.
    </p>

    <div class="flex flex-wrap gap-2 mt-6 mx-auto text-center justify-center">
      <span class="px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-300 text-sm">
        Raspberry Pi 5
      </span>

      <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-sm">
        Raspberry Pi Pico 2 W
      </span>

      <span class="px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-300 text-sm">
        Python
      </span>

      <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-sm">
        MQTT
      </span>

      <span class="px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-300 text-sm">
        ADS-B
      </span>
    </div>
  </div>


  <!-- HoloGlobe IMAGE -->
  <div class="mt-8 flex flex-col items-center">

    <div class="w-full max-w-2xl z-[9999] rounded-2xl overflow-hidden border border-blue-500/30 bg-gray-900 glow">
      <Image
        src={HoloGlobe}
        alt="Der rotierende HoloGlobe mit leuchtenden LEDs"
        class="w-full h-auto"
        priority
      />
    </div>

    <p class="text-xs text-gray-500 mt-2 text-center">
      Der fertige HoloGlobe während der Entwicklung
    </p>

  </div>

</section>


  <!-- PROJEKTÜBERSICHT -->
  <section class="mb-12">
    <div class="holo-grid rounded-2xl p-6 md:p-8 border border-blue-500/20">

      <h2 class="text-2xl font-bold text-white mb-4">
        Das Projekt
      </h2>

      <p class="text-gray-300 leading-relaxed max-w-4xl mx-auto text-center">
        Ziel des Projekts war es, einen vorhandenen, stark veralteten, rotierenden LED-Globus
        technisch weiterzuentwickeln. Statt einer statischen Darstellung
        sollte der Globus aktuelle Flugzeuge in seiner Umgebung anzeigen.
      </p>

      <p class="text-gray-400 leading-relaxed max-w-4xl mt-4 mx-auto text-center">
        Dafür mussten mehrere Systeme miteinander verbunden werden:
        Funkempfang, Datenverarbeitung, Weboberfläche, drahtlose Kommunikation,
        Mikrocontroller, Motorsteuerung, Positionssensorik und die
        LED-Ansteuerung mussten zuverlässig zusammenspielen.
      </p>

    </div>
  </section>


  <!-- DIE DREI KERNBEREICHE -->
  <section class="mb-12">

    <h2 class="text-2xl font-bold text-white mb-6">
      Drei zentrale Komponenten
    </h2>

    <div class="grid md:grid-cols-3 gap-5">

      <!-- ADS-B -->
      <div class="rounded-2xl p-6 bg-gray-900 border border-blue-500/20 hover:border-blue-500/50 transition">

        <div class="text-blue-400 text-3xl mb-4">
          ◉
        </div>

        <h3 class="text-xl font-bold text-white mb-3">
          ADS-B Tracking
        </h3>

        <p class="text-gray-400 leading-relaxed">
          Mit einem HackRF One werden ADS-B-Signale auf
          <span class="text-blue-300">1090 MHz</span> empfangen.
          <span class="text-gray-300">dump1090-fa</span> dekodiert die
          empfangenen Nachrichten und stellt die Flugzeugdaten als JSON bereit.
        </p>

      </div>


      <!-- GLOBE -->
      <div class="rounded-2xl p-6 bg-gray-900 border border-cyan-500/20 hover:border-cyan-500/50 transition">

        <div class="text-cyan-400 text-3xl mb-4">
          ◎
        </div>

        <h3 class="text-xl font-bold text-white mb-3">
          LED-Globus
        </h3>

        <p class="text-gray-400 leading-relaxed">
          Eine rotierende SK6812 RGBW LED-Leiste erzeugt durch
          <span class="text-cyan-300">Persistence of Vision</span>
          ein zusammenhängendes Weltbild. Flugzeuge werden an ihrer
          geografischen Position dargestellt.
        </p>

      </div>


      <!-- FIRMWARE -->
      <div class="rounded-2xl p-6 bg-gray-900 border border-blue-500/20 hover:border-blue-500/50 transition">

        <div class="text-blue-400 text-3xl mb-4">
          ◇
        </div>

        <h3 class="text-xl font-bold text-white mb-3">
          Embedded System
        </h3>

        <p class="text-gray-400 leading-relaxed">
          Ein Raspberry Pi Pico 2 W übernimmt die Ansteuerung des
          LED-Systems. MQTT überträgt die ausgewählten Flugzeuge und
          Steuerbefehle drahtlos vom Raspberry Pi zum Globus.
        </p>

      </div>

    </div>
  </section>


  <!-- ARCHITEKTUR -->
  <section class="mb-12">

    <h2 class="text-2xl font-bold text-white mb-6">
      Systemarchitektur
    </h2>

    <div class="rounded-2xl bg-gray-950 border border-blue-500/20 p-6 md:p-8">

      <div class="flex flex-col md:flex-row items-center justify-center gap-3 md:gap-2 text-center">

        <div class="rounded-xl border border-blue-500/30 bg-blue-500/5 px-5 py-4 min-w-[150px]">
          <div class="text-blue-400 font-bold">HackRF One</div>
          <div class="text-xs text-gray-500 mt-1">1090 MHz</div>
        </div>

        <div class="architecture-arrow hidden md:block">→</div>
        <div class="text-blue-400 md:hidden">↓</div>

        <div class="rounded-xl border border-blue-500/30 bg-blue-500/5 px-5 py-4 min-w-[150px]">
          <div class="text-blue-400 font-bold">dump1090-fa</div>
          <div class="text-xs text-gray-500 mt-1">ADS-B Decoder</div>
        </div>

        <div class="architecture-arrow hidden md:block">→</div>
        <div class="text-blue-400 md:hidden">↓</div>

        <div class="rounded-xl border border-cyan-500/30 bg-cyan-500/5 px-5 py-4 min-w-[150px]">
          <div class="text-cyan-400 font-bold">Raspberry Pi 5</div>
          <div class="text-xs text-gray-500 mt-1">Backend + Web UI</div>
        </div>

        <div class="architecture-arrow hidden md:block">→</div>
        <div class="text-blue-400 md:hidden">↓</div>

        <div class="rounded-xl border border-cyan-500/30 bg-cyan-500/5 px-5 py-4 min-w-[150px]">
          <div class="text-cyan-400 font-bold">MQTT</div>
          <div class="text-xs text-gray-500 mt-1">Wireless</div>
        </div>

        <div class="architecture-arrow hidden md:block">→</div>
        <div class="text-blue-400 md:hidden">↓</div>

        <div class="rounded-xl border border-blue-500/30 bg-blue-500/5 px-5 py-4 min-w-[150px]">
          <div class="text-blue-400 font-bold">Pico 2 W</div>
          <div class="text-xs text-gray-500 mt-1">Firmware</div>
        </div>

        <div class="architecture-arrow hidden md:block">→</div>
        <div class="text-blue-400 md:hidden">↓</div>

        <div class="rounded-xl border border-cyan-500/30 bg-cyan-500/5 px-5 py-4 min-w-[150px]">
          <div class="text-cyan-400 font-bold">LED Globe</div>
          <div class="text-xs text-gray-500 mt-1">POV Display</div>
        </div>

      </div>

    </div>
  </section>


  <!-- TECHNISCHE HERAUSFORDERUNGEN -->
  <section class="mb-12">

    <h2 class="text-2xl font-bold text-white mb-6">
      Technische Herausforderungen
    </h2>

    <div class="grid md:grid-cols-2 gap-5">

      <div class="tech-line pl-6 p-5 bg-gray-900 rounded-xl">
        <h3 class="text-lg font-bold text-white mb-2">
          Motorsteuerung
        </h3>

        <p class="text-gray-400">
          Die Drehzahl des Globus musste stabil gehalten werden.
          Dabei wurden PWM-Frequenzen untersucht, Bauteile der
          Motorsteuerung ausgetauscht und die Stromversorgung angepasst.
        </p>
      </div>


      <div class="tech-line pl-6 p-5 bg-gray-900 rounded-xl">
        <h3 class="text-lg font-bold text-white mb-2">
          Drehzahlerfassung
        </h3>

        <p class="text-gray-400">
          Ein Hall-Sensor erkennt jede Umdrehung. Die Messwerte werden
          softwareseitig gefiltert, um Störungen und unrealistische
          Messwerte auszugleichen.
        </p>
      </div>


      <div class="tech-line pl-6 p-5 bg-gray-900 rounded-xl">
        <h3 class="text-lg font-bold text-white mb-2">
          PIO & DMA
        </h3>

        <p class="text-gray-400">
          Die LED-Datenübertragung darf die Verarbeitung der Hall-Sensor-
          Interrupts nicht blockieren. Deshalb wurden die
          Programmable-I/O-Einheiten und DMA des Pico genutzt.
        </p>
      </div>


      <div class="tech-line pl-6 p-5 bg-gray-900 rounded-xl">
        <h3 class="text-lg font-bold text-white mb-2">
          Stromversorgung
        </h3>

        <p class="text-gray-400">
          Motor und LEDs stellen unterschiedliche Anforderungen an die
          Stromversorgung. Durch Messungen und Anpassungen der
          Spannungsversorgung wurde ein stabiler Dauerbetrieb erreicht.
        </p>
      </div>


      <div class="tech-line pl-6 p-5 bg-gray-900 rounded-xl">
        <h3 class="text-lg font-bold text-white mb-2">
          Slip Ring
        </h3>

        <p class="text-gray-400">
          Die rotierende Konstruktion benötigt eine zuverlässige
          Strom- und Datenübertragung. Ein Hohlwellen-Schleifring ermöglicht
          die Verbindung zwischen stehender und rotierender Elektronik.
        </p>
      </div>


      <div class="tech-line pl-6 p-5 bg-gray-900 rounded-xl">
        <h3 class="text-lg font-bold text-white mb-2">
          Echtzeitdarstellung
        </h3>

        <p class="text-gray-400">
          Flugzeugkoordinaten müssen vom ADS-B-Empfang über das Backend
          bis zur LED-Darstellung übertragen werden. Dabei wurde eine
          möglichst geringe Latenz angestrebt.
        </p>
      </div>

    </div>
  </section>


  <!-- TECHNOLOGIEN -->
  <section class="mb-12">

    <h2 class="text-2xl font-bold text-white mb-6">
      Technologien & Methoden
    </h2>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">

      <div class="rounded-xl bg-blue-500/5 border border-blue-500/20 p-5">
        <h3 class="font-bold text-blue-300 mb-3">Software</h3>
        <p class="text-gray-400 text-sm leading-7">
          Python · FastAPI · HTML · CSS · JavaScript · MicroPython
        </p>
      </div>

      <div class="rounded-xl bg-cyan-500/5 border border-cyan-500/20 p-5">
        <h3 class="font-bold text-cyan-300 mb-3">Kommunikation</h3>
        <p class="text-gray-400 text-sm leading-7">
          MQTT · JSON · WLAN · ADS-B · REST
        </p>
      </div>

      <div class="rounded-xl bg-blue-500/5 border border-blue-500/20 p-5">
        <h3 class="font-bold text-blue-300 mb-3">Embedded</h3>
        <p class="text-gray-400 text-sm leading-7">
          Raspberry Pi · Pico 2 W · PIO · DMA · Interrupts
        </p>
      </div>

      <div class="rounded-xl bg-cyan-500/5 border border-cyan-500/20 p-5">
        <h3 class="font-bold text-cyan-300 mb-3">Hardware</h3>
        <p class="text-gray-400 text-sm leading-7">
          SK6812 RGBW · Hall-Sensor · Motor · HackRF One
        </p>
      </div>

      <div class="rounded-xl bg-blue-500/5 border border-blue-500/20 p-5">
        <h3 class="font-bold text-blue-300 mb-3">Deployment</h3>
        <p class="text-gray-400 text-sm leading-7">
          Ubuntu · systemd · Sway · Chromium Kiosk · SSH
        </p>
      </div>

      <div class="rounded-xl bg-cyan-500/5 border border-cyan-500/20 p-5">
        <h3 class="font-bold text-cyan-300 mb-3">Entwicklung</h3>
        <p class="text-gray-400 text-sm leading-7">
          Git · GitHub · GitHub Actions · Unit Tests · Scrum
        </p>
      </div>

    </div>
  </section>

  <!-- ABSCHLUSS -->
  <section class="rounded-2xl p-8 bg-gradient-to-br from-blue-500/10 to-cyan-500/5 border border-blue-500/20">

    <h2 class="text-2xl font-bold text-white mb-4">
      Was ich aus dem Projekt mitgenommen habe
    </h2>

    <p class="text-gray-300 leading-relaxed max-w-4xl mx-auto text-center">
      Der HoloGlobe hat besonders gezeigt, wie stark Softwareentwicklung
      und Hardwareentwicklung bei einem Embedded-System voneinander
      abhängig sind. Änderungen an Motor, Sensorik oder LED-Timing wirken
      sich direkt auf die Software aus – und umgekehrt.
    </p>

    <p class="text-gray-400 leading-relaxed max-w-4xl mt-4 mx-auto text-center">
      Neben der eigentlichen Programmierung stand deshalb vor allem das
      systematische Messen, Debuggen und Zusammenspiel verschiedener
      Komponenten im Mittelpunkt.
    </p>

  </section>

</Project>